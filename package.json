{
  "name": "829-memory",
  "private": true,
  "version": "1.1.1",
  "description": "829 石油与天然气工程综合主动回忆与间隔复习桌面应用",
  "author": "HZ-KMNO",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:build": "pnpm build && electron-builder --win nsis",
    "audit:questions": "python tools/audit_question_bank.py",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.2",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "cn.hzkmno.memory829",
    "productName": "829石油与天然气工程综合记忆计划",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/app-shortcut-icon-v3.ico",
        "to": "app-icon.ico"
      }
    ],
    "directories": {
      "output": "desktop-app-v1.1.1"
    },
    "win": {
      "icon": "public/app-shortcut-icon-v3.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "829-memory-plan-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "829 记忆计划",
      "deleteAppDataOnUninstall": false
    }
  }
}
